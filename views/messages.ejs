<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Nine Lives Vintage | Messages</title>
    <link rel="stylesheet" href="/css/listings.css" />
  </head>
  <body class="has-mobile-nav messages-page">
    <div class="page-shell narrow-shell">
      <header class="messages-header" aria-label="Messages header">
        <div>
          <p class="eyebrow muted">Inbox</p>
          <h1>Messages</h1>
          <p class="selected-category">Manage eBay and website conversations from one place.</p>
        </div>
      </header>

      <% if (statusBanner) { %>
        <div class="status-banner warning"><%= statusBanner %></div>
      <% } %>

      <main class="wizard-card messages-card">
        <div class="messages-tabs" role="tablist" aria-label="Message sources">
          <button
            type="button"
            class="messages-tab is-active"
            id="messages-tab-ebay"
            role="tab"
            aria-selected="true"
            aria-controls="messages-panel-ebay"
            data-target="ebay"
            <%= !isEbayConnected ? 'disabled' : '' %>
          >
            eBay
          </button>
          <button
            type="button"
            class="messages-tab"
            id="messages-tab-website"
            role="tab"
            aria-selected="false"
            aria-controls="messages-panel-website"
            data-target="website"
          >
            Website
          </button>
        </div>

        <section
          class="messages-panel is-active"
          id="messages-panel-ebay"
          role="tabpanel"
          aria-labelledby="messages-tab-ebay"
        >
          <% if (!isEbayConnected) { %>
            <div class="inline-message muted">eBay messages are disabled until eBay is connected and synced.</div>
          <% } else { %>
            <div class="messages-layout" id="ebay-messages-layout">
              <aside class="conversation-list-wrap" aria-label="eBay conversations">
                <div class="conversation-list-header">
                  <h2>Conversations</h2>
                  <button type="button" class="secondary-btn tiny-btn" id="refresh-ebay-conversations">Refresh</button>
                </div>
                <div id="ebay-conversation-status" class="conversation-status" aria-live="polite"></div>
                <ul id="ebay-conversation-list" class="conversation-list"></ul>
              </aside>

              <section class="thread-wrap" aria-label="Conversation thread">
                <div class="thread-header">
                  <h2 id="thread-title">Select a conversation</h2>
                  <p id="thread-subtitle" class="thread-subtitle"></p>
                </div>
                <div id="ebay-thread-status" class="conversation-status" aria-live="polite"></div>
                <div id="ebay-thread" class="thread-messages">
                  <div class="thread-empty">Choose a conversation to load messages.</div>
                </div>
              </section>
            </div>
          <% } %>
        </section>

        <section
          class="messages-panel"
          id="messages-panel-website"
          role="tabpanel"
          aria-labelledby="messages-tab-website"
          hidden
        >
          <div class="inline-message muted">
            Website messages are coming soon. This tab is ready for your local customer inbox integration.
          </div>
        </section>
      </main>

      <%- include('partials/mobile-nav', { currentPath }) %>
    </div>

    <script>
      (function () {
        const tabs = Array.from(document.querySelectorAll('.messages-tab'));
        const panels = {
          ebay: document.getElementById('messages-panel-ebay'),
          website: document.getElementById('messages-panel-website'),
        };

        const ebayConversationList = document.getElementById('ebay-conversation-list');
        const ebayConversationStatus = document.getElementById('ebay-conversation-status');
        const ebayThreadStatus = document.getElementById('ebay-thread-status');
        const ebayThread = document.getElementById('ebay-thread');
        const threadTitle = document.getElementById('thread-title');
        const threadSubtitle = document.getElementById('thread-subtitle');
        const refreshEbayConversationsButton = document.getElementById('refresh-ebay-conversations');

        let activeConversationId = '';
        let ebayConversations = [];

        const escapeHtml = (value) => String(value || '')
          .replace(/&/g, '&amp;')
          .replace(/</g, '&lt;')
          .replace(/>/g, '&gt;')
          .replace(/"/g, '&quot;')
          .replace(/'/g, '&#39;');

        const formatDateTime = (value) => {
          const date = value ? new Date(value) : null;
          if (!date || Number.isNaN(date.getTime())) {
            return 'Unknown';
          }
          return date.toLocaleString('en-US', {
            month: 'short',
            day: 'numeric',
            hour: 'numeric',
            minute: '2-digit',
          });
        };

        const setActiveTab = (target) => {
          tabs.forEach((tab) => {
            const isTarget = tab.dataset.target === target;
            tab.classList.toggle('is-active', isTarget);
            tab.setAttribute('aria-selected', isTarget ? 'true' : 'false');
          });

          Object.entries(panels).forEach(([key, panel]) => {
            if (!panel) return;
            const isTarget = key === target;
            panel.classList.toggle('is-active', isTarget);
            panel.hidden = !isTarget;
          });
        };

        const renderThreadMessages = (messages) => {
          if (!ebayThread) {
            return;
          }

          if (!Array.isArray(messages) || !messages.length) {
            ebayThread.innerHTML = '<div class="thread-empty">No messages in this conversation yet.</div>';
            return;
          }

          ebayThread.innerHTML = messages.map((message) => {
            const messageClass = message.sentByUs ? 'thread-message sent' : 'thread-message received';
            const author = escapeHtml(message.username || (message.sentByUs ? 'You' : 'Buyer'));
            const body = escapeHtml(message.messageText || '');
            const dateLabel = escapeHtml(formatDateTime(message.messageDate));

            return ''
              + '<article class="' + messageClass + '">'
              + '<header><strong>' + author + '</strong><time>' + dateLabel + '</time></header>'
              + '<p>' + body + '</p>'
              + '</article>';
          }).join('');
        };

        const loadThread = async (conversationId) => {
          if (!conversationId) {
            return;
          }

          ebayThreadStatus.textContent = 'Loading messages...';

          try {
            const response = await fetch('/api/messages/ebay/conversations/' + encodeURIComponent(conversationId) + '/messages');
            const payload = await response.json();

            if (!response.ok || !payload?.ok) {
              throw new Error(payload?.error || 'Unable to load messages.');
            }

            ebayThreadStatus.textContent = '';
            renderThreadMessages(payload.messages || []);
          } catch (error) {
            ebayThreadStatus.textContent = error.message || 'Unable to load messages.';
            ebayThread.innerHTML = '<div class="thread-empty">Unable to load this conversation.</div>';
          }
        };

        const renderConversationList = () => {
          if (!ebayConversationList) {
            return;
          }

          if (!ebayConversations.length) {
            ebayConversationList.innerHTML = '<li class="conversation-empty">No eBay conversations found.</li>';
            return;
          }

          ebayConversationList.innerHTML = ebayConversations.map((conversation) => {
            const id = String(conversation.convoId || '');
            const username = escapeHtml(conversation.username || 'Unknown user');
            const sku = escapeHtml(conversation.refrenceSku || 'No SKU');
            const preview = escapeHtml(conversation.lastMessage || 'No message text');
            const dateLabel = escapeHtml(formatDateTime(conversation.lastMessageDate));
            const unreadClass = conversation.lastMessageRead === false ? 'is-unread' : '';
            const activeClass = id === activeConversationId ? 'is-active' : '';

            return ''
              + '<li>'
              + '<button type="button" class="conversation-item ' + unreadClass + ' ' + activeClass + '" data-conversation-id="' + escapeHtml(id) + '">'
              + '<span class="conversation-top"><strong>' + username + '</strong><time>' + dateLabel + '</time></span>'
              + '<span class="conversation-meta">SKU: ' + sku + '</span>'
              + '<span class="conversation-preview">' + preview + '</span>'
              + '</button>'
              + '</li>';
          }).join('');

          ebayConversationList.querySelectorAll('[data-conversation-id]').forEach((button) => {
            button.addEventListener('click', async () => {
              const conversationId = String(button.getAttribute('data-conversation-id') || '').trim();
              if (!conversationId) {
                return;
              }

              activeConversationId = conversationId;
              const selected = ebayConversations.find((row) => String(row.convoId) === conversationId);
              threadTitle.textContent = selected?.username ? String(selected.username) : 'Conversation';
              threadSubtitle.textContent = selected?.refrenceSku ? ('SKU: ' + selected.refrenceSku) : '';
              renderConversationList();
              await loadThread(conversationId);
            });
          });
        };

        const loadConversations = async () => {
          if (!ebayConversationStatus) {
            return;
          }

          ebayConversationStatus.textContent = 'Loading conversations...';
          if (ebayThreadStatus) {
            ebayThreadStatus.textContent = '';
          }

          try {
            const response = await fetch('/api/messages/ebay/conversations');
            const payload = await response.json();

            if (!response.ok || !payload?.ok) {
              throw new Error(payload?.error || 'Unable to load conversations.');
            }

            ebayConversations = Array.isArray(payload.conversations) ? payload.conversations : [];
            ebayConversationStatus.textContent = '';
            activeConversationId = '';
            threadTitle.textContent = 'Select a conversation';
            threadSubtitle.textContent = '';
            if (ebayThread) {
              ebayThread.innerHTML = '<div class="thread-empty">Choose a conversation to load messages.</div>';
            }
            renderConversationList();
          } catch (error) {
            ebayConversations = [];
            ebayConversationStatus.textContent = error.message || 'Unable to load conversations.';
            renderConversationList();
          }
        };

        tabs.forEach((tab) => {
          tab.addEventListener('click', async () => {
            const target = tab.dataset.target;
            if (!target) return;

            setActiveTab(target);
            if (target === 'ebay' && !tab.disabled && (!ebayConversations.length)) {
              await loadConversations();
            }
          });
        });

        refreshEbayConversationsButton?.addEventListener('click', async () => {
          await loadConversations();
        });

        const activeEbayTab = document.getElementById('messages-tab-ebay');
        if (activeEbayTab && !activeEbayTab.disabled) {
          void loadConversations();
        } else {
          setActiveTab('website');
        }
      })();
    </script>
  </body>
</html>
