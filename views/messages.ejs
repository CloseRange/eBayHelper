<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Nine Lives Vintage | Messages</title>
    <link rel="stylesheet" href="/css/listings.css" />
  </head>
  <body class="has-mobile-nav messages-page">
    <div class="page-shell narrow-shell">
      <header class="messages-header" aria-label="Messages header">
        <div>
          <p class="eyebrow muted">Inbox</p>
          <h1>Messages</h1>
          <p class="selected-category">Manage eBay and website conversations from one place.</p>
        </div>
      </header>

      <% if (statusBanner) { %>
        <div class="status-banner warning"><%= statusBanner %></div>
      <% } %>

      <main class="wizard-card messages-card">
        <div class="messages-tabs" role="tablist" aria-label="Message sources">
          <button
            type="button"
            class="messages-tab is-active"
            id="messages-tab-ebay"
            role="tab"
            aria-selected="true"
            aria-controls="messages-panel-ebay"
            data-target="ebay"
            <%= !isEbayConnected ? 'disabled' : '' %>
          >
            eBay
          </button>
          <button
            type="button"
            class="messages-tab"
            id="messages-tab-website"
            role="tab"
            aria-selected="false"
            aria-controls="messages-panel-website"
            data-target="website"
          >
            Website
          </button>
        </div>

        <section
          class="messages-panel is-active"
          id="messages-panel-ebay"
          role="tabpanel"
          aria-labelledby="messages-tab-ebay"
        >
          <% if (!isEbayConnected) { %>
            <div class="inline-message muted">eBay messages are disabled until eBay is connected and synced.</div>
          <% } else { %>
            <section class="conversation-list-wrap" aria-label="eBay conversations">
              <div class="conversation-list-header">
                <h2>eBay conversations</h2>
                <button type="button" class="secondary-btn tiny-btn" id="refresh-ebay-conversations">Refresh</button>
              </div>
              <div id="ebay-conversation-status" class="conversation-status" aria-live="polite"></div>
              <ul id="ebay-conversation-list" class="conversation-list"></ul>
            </section>
          <% } %>
        </section>

        <section
          class="messages-panel"
          id="messages-panel-website"
          role="tabpanel"
          aria-labelledby="messages-tab-website"
          hidden
        >
          <section class="conversation-list-wrap" aria-label="Website conversations">
            <div class="conversation-list-header">
              <h2>Website conversations</h2>
            </div>
            <div id="website-conversation-status" class="conversation-status" aria-live="polite"></div>
            <ul id="website-conversation-list" class="conversation-list"></ul>
          </section>
        </section>
      </main>

      <%- include('partials/mobile-nav', { currentPath }) %>
    </div>

    <script>
      (function () {
        const tabs = Array.from(document.querySelectorAll('.messages-tab'));
        const panels = {
          ebay: document.getElementById('messages-panel-ebay'),
          website: document.getElementById('messages-panel-website'),
        };

        const ebayConversationList = document.getElementById('ebay-conversation-list');
        const ebayConversationStatus = document.getElementById('ebay-conversation-status');
        const websiteConversationList = document.getElementById('website-conversation-list');
        const websiteConversationStatus = document.getElementById('website-conversation-status');
        const refreshEbayConversationsButton = document.getElementById('refresh-ebay-conversations');

        let activeEbayConversationId = '';
        let activeWebsiteConversationId = '';
        let ebayConversations = [];
        let websiteConversations = [];

        const escapeHtml = (value) => String(value || '')
          .replace(/&/g, '&amp;')
          .replace(/</g, '&lt;')
          .replace(/>/g, '&gt;')
          .replace(/"/g, '&quot;')
          .replace(/'/g, '&#39;');

        const formatDateTime = (value) => {
          const date = value ? new Date(value) : null;
          if (!date || Number.isNaN(date.getTime())) {
            return 'Unknown';
          }
          return date.toLocaleString('en-US', {
            month: 'short',
            day: 'numeric',
            hour: 'numeric',
            minute: '2-digit',
          });
        };

        const setActiveTab = (target) => {
          tabs.forEach((tab) => {
            const isTarget = tab.dataset.target === target;
            tab.classList.toggle('is-active', isTarget);
            tab.setAttribute('aria-selected', isTarget ? 'true' : 'false');
          });

          Object.entries(panels).forEach(([key, panel]) => {
            if (!panel) return;
            const isTarget = key === target;
            panel.classList.toggle('is-active', isTarget);
            panel.hidden = !isTarget;
          });
        };

        const renderConversationList = (listElement, rows, activeConversationId, onSelect) => {
          if (!listElement) {
            return;
          }

          if (!rows.length) {
            listElement.innerHTML = '<li class="conversation-empty">No conversations found.</li>';
            return;
          }

          listElement.innerHTML = rows.map((conversation) => {
            const id = String(conversation.convoId || '');
            const username = escapeHtml(conversation.username || 'Unknown user');
            const sku = escapeHtml(conversation.refrenceSku || 'No SKU');
            const preview = escapeHtml(conversation.lastMessage || 'No message text');
            const dateLabel = escapeHtml(formatDateTime(conversation.lastMessageDate));
            const unreadClass = conversation.lastMessageRead === false ? 'is-unread' : '';
            const activeClass = id === activeConversationId ? 'is-active' : '';
            const unreadDot = conversation.lastMessageRead === false
              ? '<span class="conversation-unread-dot" aria-label="Unread"></span>'
              : '<span class="conversation-unread-dot conversation-unread-dot-hidden" aria-hidden="true"></span>';

            return ''
              + '<li>'
              + '<button type="button" class="conversation-item ' + unreadClass + ' ' + activeClass + '" data-conversation-id="' + escapeHtml(id) + '">'
              + '<span class="conversation-top">'
              + '<strong>' + username + '</strong>'
              + '<span class="conversation-right">'
              + unreadDot
              + '<time>' + dateLabel + '</time>'
              + '</span>'
              + '</span>'
              + '<span class="conversation-meta">SKU: ' + sku + '</span>'
              + '<span class="conversation-preview">' + preview + '</span>'
              + '</button>'
              + '</li>';
          }).join('');

          listElement.querySelectorAll('[data-conversation-id]').forEach((button) => {
            button.addEventListener('click', () => {
              const conversationId = String(button.getAttribute('data-conversation-id') || '').trim();
              if (!conversationId) {
                return;
              }

              onSelect(conversationId);
            });
          });
        };

        const renderEbayConversations = () => {
          renderConversationList(ebayConversationList, ebayConversations, activeEbayConversationId, (conversationId) => {
            activeEbayConversationId = conversationId;
            renderEbayConversations();
          });
        };

        const renderWebsiteConversations = () => {
          renderConversationList(websiteConversationList, websiteConversations, activeWebsiteConversationId, (conversationId) => {
            activeWebsiteConversationId = conversationId;
            renderWebsiteConversations();
          });
        };

        const loadConversations = async () => {
          if (!ebayConversationStatus) {
            return;
          }

          ebayConversationStatus.textContent = 'Loading conversations...';

          try {
            const response = await fetch('/api/messages/ebay/conversations');
            const payload = await response.json();

            if (!response.ok || !payload?.ok) {
              throw new Error(payload?.error || 'Unable to load conversations.');
            }

            ebayConversations = Array.isArray(payload.conversations) ? payload.conversations : [];
            ebayConversationStatus.textContent = '';
            activeEbayConversationId = '';
            renderEbayConversations();
          } catch (error) {
            ebayConversations = [];
            ebayConversationStatus.textContent = error.message || 'Unable to load conversations.';
            renderEbayConversations();
          }
        };

        const loadWebsiteConversations = () => {
          websiteConversations = [];
          activeWebsiteConversationId = '';

          if (websiteConversationStatus) {
            websiteConversationStatus.textContent = 'Website inbox will appear here when local website messaging is connected.';
          }

          renderWebsiteConversations();
        };

        tabs.forEach((tab) => {
          tab.addEventListener('click', async () => {
            const target = tab.dataset.target;
            if (!target) return;

            setActiveTab(target);
            if (target === 'ebay' && !tab.disabled && (!ebayConversations.length)) {
              await loadConversations();
            }
          });
        });

        refreshEbayConversationsButton?.addEventListener('click', async () => {
          await loadConversations();
        });

        const activeEbayTab = document.getElementById('messages-tab-ebay');
        if (activeEbayTab && !activeEbayTab.disabled) {
          void loadConversations();
        } else {
          setActiveTab('website');
        }

        loadWebsiteConversations();
      })();
    </script>
  </body>
</html>
