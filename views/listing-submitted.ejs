<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Nine Lives Vintage | Listing Submitted</title>
    <link rel="stylesheet" href="/css/listings.css" />
  </head>
  <body>
    <div class="page-shell narrow-shell">
      <header class="wizard-header">
        <div class="wizard-title-block">
          <div class="brand-lockup">
            <img src="/res/logo-brand.png" alt="Nine Lives Vintage logo" class="brand-logo-mark" />
            <p class="brand-wordmark">Nine Lives Vintage</p>
          </div>
          <h1>Listing created</h1>
        </div>
        <a class="close-button" href="/dashboard" aria-label="Close and return to listings">×</a>
      </header>

      <section class="wizard-card submitted-card">
        <div class="submitted-badge">SKU</div>
        <div class="submitted-sku"><%= sku %></div>
        <p class="submitted-note">Your listing has been generated.</p>
      </section>

      <div class="wizard-actions single-action">
        <a href="/dashboard" class="primary-btn submitted-close">Close</a>
      </div>
    </div>
  </body>
</html>
