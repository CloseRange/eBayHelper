<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Nine Lives Vintage | Listing Submitted</title>
    <link rel="stylesheet" href="/css/listings.css" />
  </head>
  <body>
    <div class="page-shell narrow-shell">
      <header class="top-logo-bar" aria-label="Site header">
        <img src="/res/logo-header.png" alt="Nine Lives Vintage" class="top-logo-image" />
      </header>

      <section class="wizard-card submitted-card">
        <div class="submitted-badge">SKU</div>
        <div class="submitted-sku"><%= sku %></div>
        <p class="submitted-note">Your listing has been generated.</p>
        <p class="print-sku-status" id="submitted-print-sku-status" aria-live="polite"></p>
      </section>

      <div class="wizard-actions">
        <button type="button" class="secondary-btn" id="submitted-print-sku-button">Print SKU Label</button>
        <a href="/dashboard" class="primary-btn submitted-close">Close</a>
      </div>
    </div>

    <script>
      (function () {
        const sku = '<%= sku %>';
        const printButton = document.getElementById('submitted-print-sku-button');
        const status = document.getElementById('submitted-print-sku-status');

        if (!sku || !printButton) {
          return;
        }

        const setStatus = (message) => {
          if (status) {
            status.textContent = message;
          }
        };

        const printSkuLabel = async () => {
          const printPopup = window.open('about:blank', '_blank');
          if (!printPopup) {
            setStatus('Popup blocked. Allow popups, then try again.');
            return;
          }

          printPopup.document.write('<!doctype html><html><head><meta charset="utf-8"><title>Preparing label...</title><style>body{font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;padding:20px;color:#1f2937}p{margin:0 0 12px}</style></head><body><p>Preparing SKU label...</p><p>If print does not start automatically, use Cmd+P.</p></body></html>');
          printPopup.document.close();

          printButton.disabled = true;
          setStatus('Printing...');

          try {
            const response = await fetch('/api/listing/' + encodeURIComponent(sku) + '/label.pdf', {
              method: 'GET',
              headers: {
                Accept: 'application/pdf',
              },
            });

            if (!response.ok) {
              const contentType = response.headers.get('content-type') || '';
              if (contentType.includes('application/json')) {
                const payload = await response.json().catch(() => ({}));
                throw new Error(payload && payload.error ? payload.error : 'Unable to print SKU label.');
              }
              throw new Error('Unable to print SKU label.');
            }

            const pdfBlob = await response.blob();
            if (!pdfBlob || pdfBlob.size === 0) {
              throw new Error('Received an empty label PDF.');
            }

            const pdfUrl = URL.createObjectURL(pdfBlob);
            printPopup.location.replace(pdfUrl);

            window.setTimeout(() => {
              try {
                printPopup.focus();
                printPopup.print();
              } catch (printError) {
                console.warn('[submitted-print-sku] popup print call failed:', printError);
              }
            }, 700);

            window.setTimeout(() => {
              URL.revokeObjectURL(pdfUrl);
            }, 120000);

            setStatus('Label PDF opened. If print dialog does not appear, press Cmd+P in the new tab.');
          } catch (error) {
            try {
              printPopup.close();
            } catch (closeError) {
              // noop
            }
            setStatus(error && error.message ? error.message : 'Unable to print SKU label.');
          } finally {
            printButton.disabled = false;
          }
        };

        printButton.addEventListener('click', printSkuLabel);
      })();
    </script>
  </body>
</html>
