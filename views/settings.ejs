<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Nine Lives Vintage | Settings</title>
    <link rel="stylesheet" href="/css/listings.css" />
  </head>
  <body class="has-mobile-nav">
    <div class="page-shell narrow-shell">
      <header class="top-logo-bar" aria-label="Site header">
        <img src="/res/logo-header.png" alt="Nine Lives Vintage" class="top-logo-image" />
      </header>

      <main class="wizard-card settings-home-card">
        <div class="section-heading">
          <p class="eyebrow muted">Settings</p>
          <h2>Settings</h2>
          <p class="selected-category">Manage store configuration and pricing tools.</p>
        </div>

        <section class="settings-home-actions" aria-label="Settings actions">
          <a class="settings-link-button" href="/settings/prices">
            <span class="settings-link-leading">
              <span class="settings-link-icon"><img src="/icons/chart-line.svg" alt="" /></span>
              <span>Price Ladder</span>
            </span>
            <img class="settings-link-chevron" src="/icons/arrow-big-right.svg" alt="" />
          </a>
        </section>
      </main>

      <%- include('partials/mobile-nav', { currentPath }) %>
    </div>
  </body>
</html>
