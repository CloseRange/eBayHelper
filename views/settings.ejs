<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Miyo Threads | Settings</title>
    <link rel="stylesheet" href="/css/listings.css" />
  </head>
  <body>
    <div class="page-shell narrow-shell">
      <header class="topbar compact-topbar">
        <div class="brand-lockup">
          <p class="eyebrow">miyo threads</p>
          <h1>Settings</h1>
        </div>
      </header>

      <main class="wizard-card">
        <div class="section-heading">
          <p class="eyebrow muted">Account</p>
          <h2>eBay access</h2>
        </div>

        <div class="setting-actions">
          <a class="mint-button" href="/setupEbay">
            <img src="/icons/brain.svg" alt="Mint" />
            Mint eBay access token
          </a>

          <a class="secondary-button" href="/settings?view=logs">View logs</a>
          <a class="back-link" href="/dashboard">Back to dashboard</a>
        </div>

        <% if (showLogs) { %>
          <section class="logs-panel" aria-label="System logs">
            <div class="logs-header">
              <h3>Recent logs</h3>
            </div>

            <% if (!logs || !logs.length) { %>
              <div class="inline-message muted">No log entries found.</div>
            <% } else { %>
              <div class="log-list" role="list">
                <% logs.forEach((log) => { %>
                  <div class="log-entry" role="listitem">
                    <div class="log-meta">
                      <span class="log-badge" style="background: <%= log.color || '#8B8B9E' %>; color: #fff;">
                        <%= log.type || 'LOG' %>
                      </span>
                      <span class="log-caller"><%= log.caller || 'unknown' %></span>
                      <span class="log-time"><%= log.created_at ? new Date(log.created_at).toLocaleString() : '—' %></span>
                    </div>
                    <p class="log-message"><%= log.message || 'No message' %></p>
                  </div>
                <% }); %>
              </div>
            <% } %>
          </section>
        <% } %>
      </main>
    </div>
  </body>
</html>
