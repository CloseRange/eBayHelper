<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Nine Lives Vintage | Settings</title>
    <link rel="stylesheet" href="/css/listings.css" />
  </head>
  <body>
    <div class="page-shell narrow-shell">
      <header class="wizard-header">
        <div class="wizard-title-block">
          <div class="brand-lockup">
            <img src="/res/logo-brand.png" alt="Nine Lives Vintage logo" class="brand-logo-mark" />
            <p class="brand-wordmark">Nine Lives Vintage</p>
          </div>
          <h1>Settings</h1>
        </div>

        <a class="back-button" href="/dashboard" aria-label="Back to dashboard">
          <img src="/icons/arrow-big-left.svg" alt="Back to dashboard" />
        </a>
      </header>

      <main class="wizard-card">
        <div class="section-heading">
          <p class="eyebrow muted">Account</p>
          <h2>eBay access</h2>
        </div>

        <div class="setting-actions">
          <a class="mint-button" href="/setupEbay">
            <img src="/icons/brain.svg" alt="Mint" />
            Mint eBay access token
          </a>

          <a class="secondary-button" href="/settings/prices">Price rates</a>
          <a class="secondary-button" href="/settings/logs">View logs</a>
        </div>
      </main>
    </div>
  </body>
</html>
