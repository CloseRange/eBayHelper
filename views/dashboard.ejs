<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Nine Lives Vintage | Inventory</title>
    <link rel="stylesheet" href="/css/listings.css" />
  </head>
  <body class="has-mobile-nav">
    <div class="page-shell">
      <header class="top-logo-bar" aria-label="Site header">
        <img src="/res/logo-header.png" alt="Nine Lives Vintage" class="top-logo-image" />
      </header>

      <form method="get" action="/dashboard" class="search-form" aria-label="Search listings by SKU" id="sku-search-form">
        <label for="sku-search" class="search-label">Search by SKU</label>
        <div class="search-controls">
          <input
            id="sku-search"
            name="sku"
            type="search"
            value="<%= skuQuery || '' %>"
            placeholder="Enter SKU"
            autocomplete="off"
          />
          <button type="button" class="scan-search-button" id="scan-sku-button" aria-label="Scan barcode" title="Scan barcode">
            <img src="/icons/scan-barcode.svg" alt="" />
          </button>
        </div>
      </form>

      <section class="scanner-panel" id="scanner-panel" hidden>
        <video id="scanner-video" autoplay playsinline muted></video>
        <div class="scanner-actions">
          <p id="scanner-status" aria-live="polite">Point your camera at a SKU barcode.</p>
          <button type="button" class="scan-search-button scanner-close-button" id="scanner-close-button" aria-label="Close scanner">Close</button>
        </div>
      </section>

      <% if (error) { %>
        <div class="status-banner error"><%= error %></div>
      <% } %>

      <% if (ebayConnectionError) { %>
        <div class="status-banner warning"><%= ebayConnectionError %></div>
      <% } %>

      <div class="status-banner error" id="dashboard-load-error" hidden></div>

      <section class="empty-state" id="dashboard-empty-state" hidden>
        <div class="empty-icon-wrap">
          <img src="/icons/heart-plus.svg" alt="Package icon" />
        </div>
        <h2>No listings found</h2>
        <p>No rows matched your SKU search in the listing table.</p>
      </section>

      <main class="listing-card-grid is-loading" id="listing-card-grid" data-state-filter="<%= typeof stateFilter === 'number' ? stateFilter : 1 %>" aria-label="Listing cards">
          <% for (let i = 0; i < 6; i += 1) { %>
            <article class="listing-card listing-card-skeleton" aria-hidden="true">
              <div class="listing-card-image-wrap listing-card-image-wrap-skeleton">
                <span class="skeleton-block skeleton-image"></span>
              </div>
              <div class="listing-card-body">
                <span class="skeleton-block skeleton-title"></span>
                <span class="skeleton-block skeleton-title skeleton-title-short"></span>
                <div class="listing-card-meta listing-card-meta-skeleton">
                  <span class="skeleton-block skeleton-pill"></span>
                  <span class="skeleton-block skeleton-sku"></span>
                </div>
              </div>
            </article>
          <% } %>
          <div class="listing-card-empty" id="search-empty-row" role="status" aria-live="polite" hidden>
            <span class="empty-row-text">No matching SKU rows.</span>
          </div>
      </main>

      <section class="listing-modal" id="listing-modal" hidden>
        <div class="listing-modal-backdrop" id="listing-modal-backdrop"></div>
        <article class="listing-modal-panel" role="dialog" aria-modal="true" aria-labelledby="listing-modal-title">
          <button type="button" class="modal-close" id="listing-modal-close" aria-label="Close details">x</button>
          <h2 id="listing-modal-title">Listing details</h2>

          <div class="modal-image-wrap" id="modal-image-wrap">
            <button type="button" class="image-nav prev" id="image-prev" aria-label="Previous image">&#8249;</button>
            <img id="modal-image" alt="Listing image" />
            <div class="image-empty" id="image-empty" hidden>No images for this listing.</div>
            <button type="button" class="image-nav next" id="image-next" aria-label="Next image">&#8250;</button>
            <div class="image-counter" id="image-counter"></div>
          </div>

          <dl class="details-grid compact-summary-grid" id="modal-details-grid">
            <div><dt>SKU</dt><dd id="detail-sku">-</dd></div>
            <div><dt>Price</dt><dd id="detail-price">-</dd></div>
            <div class="full-row"><dt>Description</dt><dd id="detail-description">-</dd></div>
          </dl>

          <div class="modal-actions">
            <div class="modal-action-buttons">
              <button type="button" class="modal-icon-button print-sku-button" id="print-sku-label-button" disabled aria-label="Print SKU Label" title="Print SKU Label">
                <img src="/icons/package.svg" alt="" />
              </button>
              <a class="modal-icon-button more-info-button is-disabled" id="more-info-button" href="#" aria-disabled="true" aria-label="More info" title="More info">
                <img src="/icons/info.svg" alt="" />
              </a>
            </div>
            <p class="print-sku-status" id="print-sku-status" aria-live="polite"></p>
            <div class="modal-text-actions">
              <button type="button" class="modal-text-button finalize-item-button" id="finalize-item-button" disabled>Finalize Item</button>
              <button type="button" class="modal-text-button modal-text-button-danger" id="delete-listing-button" disabled>Delete Item</button>
            </div>
          </div>
        </article>
      </section>

      <%- include('partials/mobile-nav', { currentPath }) %>

      <script>
        (function () {
          const form = document.getElementById('sku-search-form');
          const searchInput = document.getElementById('sku-search');
          const scanSkuButton = document.getElementById('scan-sku-button');
          const scannerPanel = document.getElementById('scanner-panel');
          const scannerVideo = document.getElementById('scanner-video');
          const scannerStatus = document.getElementById('scanner-status');
          const scannerCloseButton = document.getElementById('scanner-close-button');
          const grid = document.getElementById('listing-card-grid');
          const emptyState = document.getElementById('dashboard-empty-state');
          const loadErrorBanner = document.getElementById('dashboard-load-error');
          const modal = document.getElementById('listing-modal');
          const modalBackdrop = document.getElementById('listing-modal-backdrop');
          const closeModalButton = document.getElementById('listing-modal-close');
          const modalTitle = document.getElementById('listing-modal-title');
          const detailSku = document.getElementById('detail-sku');
          const detailPrice = document.getElementById('detail-price');
          const detailDescription = document.getElementById('detail-description');
          const imageElement = document.getElementById('modal-image');
          const imageEmpty = document.getElementById('image-empty');
          const imagePrev = document.getElementById('image-prev');
          const imageNext = document.getElementById('image-next');
          const imageCounter = document.getElementById('image-counter');
          const printSkuButton = document.getElementById('print-sku-label-button');
          const printSkuStatus = document.getElementById('print-sku-status');
          const finalizeItemButton = document.getElementById('finalize-item-button');
          const deleteListingButton = document.getElementById('delete-listing-button');
          const moreInfoButton = document.getElementById('more-info-button');
          const stateFilter = Number(grid && grid.dataset ? grid.dataset.stateFilter : 1) || 1;

          document.querySelectorAll('.state-dot[data-state-color]').forEach((dot) => {
            const color = dot.getAttribute('data-state-color') || '#B8A4E3';
            dot.style.background = color;
          });

          let rows = [];
          let emptyRow = document.getElementById('search-empty-row');
          let isGridLoading = true;
          let activeImages = [];
          let activeImageIndex = 0;
          let activeSku = '';
          let activeRow = null;
          let scannerStream = null;
          let scannerFrameId = null;
          let barcodeDetector = null;
          let scannerRunning = false;
          let zxingReader = null;
          let zxingReaderPromise = null;

          if (!searchInput) {
            return;
          }

          const escapeHtml = (value) => String(value || '')
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;')
            .replace(/'/g, '&#39;');

          const refreshRows = () => {
            rows = grid
              ? Array.from(grid.querySelectorAll('.listing-card[data-sku]'))
              : [];
            emptyRow = document.getElementById('search-empty-row');
          };

          const createCardMarkup = (listing) => {
            const title = escapeHtml(listing && listing.title ? listing.title : 'Untitled listing');
            const sku = escapeHtml(listing && listing.sku ? listing.sku : '—');
            const priceDisplay = escapeHtml(listing && listing.priceDisplay ? listing.priceDisplay : '—');
            const imageUrl = listing && listing.imageUrl ? escapeHtml(listing.imageUrl) : '';

            const imageMarkup = imageUrl
              ? '<div class="listing-card-image-wrap">'
                + '<span class="listing-card-image-skeleton" aria-hidden="true"></span>'
                + '<img src="' + imageUrl + '" alt="' + title + '" class="listing-card-image" loading="lazy" />'
                + '</div>'
              : '<div class="listing-card-image-wrap is-loaded">'
                + '<div class="listing-card-image-fallback" aria-hidden="true">'
                + '<img src="/res/logo-brand.png" alt="" />'
                + '</div>'
                + '</div>';

            return ''
              + '<article class="listing-card data-row" role="button" tabindex="0" aria-label="Open details for ' + title + '" data-sku="' + sku + '">'
              + imageMarkup
              + '<div class="listing-card-body">'
              + '<h3 class="listing-card-title">' + title + '</h3>'
              + '<div class="listing-card-meta">'
              + '<span class="listing-card-price">' + priceDisplay + '</span>'
              + '<span class="listing-card-sku">' + sku + '</span>'
              + '</div>'
              + '</div>'
              + '</article>';
          };

          const revealLoadedImages = () => {
            if (!grid) {
              return;
            }

            grid.querySelectorAll('.listing-card-image').forEach((image) => {
              const wrap = image.closest('.listing-card-image-wrap');
              if (!wrap) {
                return;
              }

              const markLoaded = () => {
                wrap.classList.add('is-loaded');
              };

              const showFallback = () => {
                wrap.classList.add('is-loaded');
                wrap.innerHTML = '<div class="listing-card-image-fallback" aria-hidden="true"><img src="/res/logo-brand.png" alt="" /></div>';
              };

              if (image.complete && image.naturalWidth > 0) {
                markLoaded();
                return;
              }

              image.addEventListener('load', markLoaded, { once: true });
              image.addEventListener('error', showFallback, { once: true });
            });
          };

          const syncEmptyState = () => {
            if (!grid) {
              return;
            }

            if (isGridLoading) {
              grid.hidden = false;
              if (emptyState) {
                emptyState.hidden = true;
              }
              if (emptyRow) {
                emptyRow.hidden = true;
              }
              return;
            }

            if (!rows.length) {
              grid.hidden = true;
              if (emptyState) {
                emptyState.hidden = false;
              }
              if (emptyRow) {
                emptyRow.hidden = true;
              }
              return;
            }

            grid.hidden = false;
            if (emptyState) {
              emptyState.hidden = true;
            }
          };

          const renderListings = (listings) => {
            if (!grid) {
              return;
            }

            isGridLoading = false;
            grid.classList.remove('is-loading');
            grid.innerHTML = (listings || []).map(createCardMarkup).join('')
              + '<div class="listing-card-empty" id="search-empty-row" role="status" aria-live="polite" hidden><span class="empty-row-text">No matching SKU rows.</span></div>';
            refreshRows();
            revealLoadedImages();
            syncEmptyState();
            applyFilter();
          };

          const setLoadError = (message) => {
            if (loadErrorBanner) {
              loadErrorBanner.textContent = message || 'Unable to load listings.';
              loadErrorBanner.hidden = false;
            }
            isGridLoading = false;
            if (grid) {
              grid.hidden = true;
              grid.classList.remove('is-loading');
            }
            if (emptyState) {
              emptyState.hidden = true;
            }
          };

          const updateImage = () => {
            if (!imageElement || !imageEmpty || !imageCounter || !imagePrev || !imageNext) {
              return;
            }

            if (!activeImages.length) {
              imageElement.hidden = true;
              imageElement.removeAttribute('src');
              imageEmpty.hidden = false;
              imageCounter.textContent = '';
              imagePrev.disabled = true;
              imageNext.disabled = true;
              return;
            }

            const imageUrl = activeImages[activeImageIndex] || '';
            imageElement.src = imageUrl;
            imageElement.hidden = false;
            imageEmpty.hidden = true;
            imageCounter.textContent = (activeImageIndex + 1) + ' / ' + activeImages.length;
            const hasMany = activeImages.length > 1;
            imagePrev.disabled = !hasMany;
            imageNext.disabled = !hasMany;
          };

          const setScannerStatus = (message) => {
            if (scannerStatus) {
              scannerStatus.textContent = message;
            }
          };

          const normalizeScannedSku = (value) => {
            return String(value || '')
              .replace(/\s+/g, '')
              .trim();
          };

          const findRowBySku = (sku) => {
            const target = String(sku || '').trim().toLowerCase();
            if (!target) {
              return null;
            }

            return rows.find((row) => {
              const rowSku = (row.getAttribute('data-sku') || '').trim().toLowerCase();
              return rowSku === target;
            }) || null;
          };

          const stopScanner = () => {
            scannerRunning = false;

            if (scannerFrameId) {
              cancelAnimationFrame(scannerFrameId);
              scannerFrameId = null;
            }

            if (scannerStream) {
              scannerStream.getTracks().forEach((track) => track.stop());
              scannerStream = null;
            }

            if (scannerVideo) {
              scannerVideo.srcObject = null;
            }

            if (zxingReader && typeof zxingReader.reset === 'function') {
              zxingReader.reset();
            }

            if (scannerPanel) {
              scannerPanel.hidden = true;
            }
          };

          const getZxingReader = async () => {
            if (zxingReader) {
              return zxingReader;
            }

            if (!zxingReaderPromise) {
              zxingReaderPromise = import('https://cdn.jsdelivr.net/npm/@zxing/browser@0.1.5/+esm')
                .then((module) => {
                  zxingReader = new module.BrowserMultiFormatReader(undefined, {
                    delayBetweenScanAttempts: 90,
                  });
                  return zxingReader;
                });
            }

            return zxingReaderPromise;
          };

          const handleScanValue = (rawValue) => {
            const scannedSku = normalizeScannedSku(rawValue);
            if (!scannedSku) {
              return false;
            }

            if (searchInput) {
              searchInput.value = scannedSku;
            }
            applyFilter();

            const matchedRow = findRowBySku(scannedSku);
            if (matchedRow) {
              activeRow = matchedRow;
              loadDetails(scannedSku);
            }

            return true;
          };

          const scanLoop = async () => {
            if (!scannerRunning || !barcodeDetector || !scannerVideo) {
              return;
            }

            try {
              const detections = await barcodeDetector.detect(scannerVideo);
              if (Array.isArray(detections) && detections.length) {
                const firstCode = detections[0] && detections[0].rawValue
                  ? String(detections[0].rawValue)
                  : '';

                if (handleScanValue(firstCode)) {
                  const matched = findRowBySku(normalizeScannedSku(firstCode));
                  if (matched) {
                    setScannerStatus('Found SKU. Opening listing...');
                  } else {
                    setScannerStatus('Scanned SKU not found. Added to search.');
                  }
                  stopScanner();
                  return;
                }
              }
            } catch (scanError) {
              setScannerStatus('Unable to read barcode. Try holding steadier.');
            }

            scannerFrameId = requestAnimationFrame(() => {
              void scanLoop();
            });
          };

          const openScanner = async () => {
            if (!scannerPanel || !scannerVideo) {
              return;
            }

            stopScanner();
            scannerPanel.hidden = false;
            setScannerStatus('Starting camera...');

            if ('BarcodeDetector' in window) {
              try {
                barcodeDetector = new window.BarcodeDetector({
                  formats: ['code_128', 'ean_13', 'ean_8', 'upc_a', 'upc_e', 'code_39', 'itf'],
                });
              } catch (detectorError) {
                barcodeDetector = null;
              }
            }

            if (barcodeDetector) {
              try {
                if (!navigator.mediaDevices || typeof navigator.mediaDevices.getUserMedia !== 'function') {
                  throw new Error('Camera API unavailable');
                }

                scannerStream = await navigator.mediaDevices.getUserMedia({
                  video: {
                    facingMode: { ideal: 'environment' },
                  },
                  audio: false,
                });
              } catch (cameraError) {
                setScannerStatus('Camera access was blocked or unavailable.');
                return;
              }

              scannerVideo.srcObject = scannerStream;
              setScannerStatus('Point your camera at a SKU barcode.');
              scannerRunning = true;
              void scanLoop();
              return;
            }

            try {
              if (!navigator.mediaDevices || typeof navigator.mediaDevices.getUserMedia !== 'function') {
                throw new Error('Camera API unavailable');
              }

              const reader = await getZxingReader();
              scannerRunning = true;
              setScannerStatus('Point your camera at a SKU barcode.');

              await reader.decodeFromVideoDevice(undefined, scannerVideo, (result) => {
                if (!scannerRunning || !result) {
                  return;
                }

                const rawValue = typeof result.getText === 'function'
                  ? result.getText()
                  : '';

                if (!handleScanValue(rawValue)) {
                  return;
                }

                const matched = findRowBySku(normalizeScannedSku(rawValue));
                if (matched) {
                  setScannerStatus('Found SKU. Opening listing...');
                } else {
                  setScannerStatus('Scanned SKU not found. Added to search.');
                }

                stopScanner();
              });
            } catch (fallbackError) {
              scannerRunning = false;
              setScannerStatus('Unable to start barcode scanning on this device.');
            }
          };

          const openModal = () => {
            if (!modal) {
              return;
            }
            modal.hidden = false;
            document.body.classList.add('modal-open');
          };

          const closeModal = () => {
            if (!modal) {
              return;
            }
            modal.hidden = true;
            document.body.classList.remove('modal-open');
            if (printSkuStatus) {
              printSkuStatus.textContent = '';
            }
          };

          const setLoadingState = (sku) => {
            if (modalTitle) modalTitle.textContent = 'Loading ' + sku + '...';
            if (detailSku) detailSku.textContent = sku || '-';
            if (detailPrice) detailPrice.textContent = '-';
            if (detailDescription) detailDescription.textContent = 'Loading details...';
            activeSku = sku || '';
            if (printSkuButton) {
              printSkuButton.disabled = !activeSku;
            }
            if (finalizeItemButton) {
              finalizeItemButton.disabled = !activeSku;
            }
            if (deleteListingButton) {
              deleteListingButton.disabled = !activeSku;
            }
            if (moreInfoButton) {
              moreInfoButton.href = activeSku ? ('/listing/' + encodeURIComponent(activeSku)) : '#';
              moreInfoButton.classList.toggle('is-disabled', !activeSku);
              moreInfoButton.setAttribute('aria-disabled', activeSku ? 'false' : 'true');
            }
            if (printSkuStatus) {
              printSkuStatus.textContent = '';
            }
            activeImages = [];
            activeImageIndex = 0;
            updateImage();
          };

          const setErrorState = (message) => {
            if (modalTitle) modalTitle.textContent = 'Listing details';
            if (detailDescription) detailDescription.textContent = message || 'Unable to load details.';
          };

          const fillDetails = (payload) => {
            const listing = payload && payload.listing ? payload.listing : {};
            const images = Array.isArray(payload && payload.images) ? payload.images : [];
            const priceValue = Number.isFinite(Number(listing.price)) ? '$' + Number(listing.price).toFixed(2) : '-';

            if (modalTitle) modalTitle.textContent = listing.title || 'Listing details';
            if (detailSku) detailSku.textContent = listing.sku || '-';
            if (detailPrice) detailPrice.textContent = priceValue;
            if (detailDescription) detailDescription.textContent = listing.description || '-';

            activeSku = listing.sku ? String(listing.sku).trim() : '';
            if (printSkuButton) {
              printSkuButton.disabled = !activeSku;
            }
            if (finalizeItemButton) {
              finalizeItemButton.disabled = !activeSku;
            }
            if (deleteListingButton) {
              deleteListingButton.disabled = !activeSku;
            }
            if (moreInfoButton) {
              moreInfoButton.href = activeSku ? ('/listing/' + encodeURIComponent(activeSku)) : '#';
              moreInfoButton.classList.toggle('is-disabled', !activeSku);
              moreInfoButton.setAttribute('aria-disabled', activeSku ? 'false' : 'true');
            }

            activeImages = images;
            activeImageIndex = 0;
            updateImage();
          };

          const printSkuLabel = async () => {
            if (!activeSku || !printSkuButton) {
              return;
            }

            const printPopup = window.open('about:blank', '_blank');
            if (!printPopup) {
              if (printSkuStatus) {
                printSkuStatus.textContent = 'Popup blocked. Allow popups, then try again.';
              }
              return;
            }

            printPopup.document.write('<!doctype html><html><head><meta charset="utf-8"><title>Preparing label...</title><style>body{font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;padding:20px;color:#1f2937}p{margin:0 0 12px}</style></head><body><p>Preparing SKU label...</p><p>If print does not start automatically, use Cmd+P.</p></body></html>');
            printPopup.document.close();

            printSkuButton.disabled = true;
            if (printSkuStatus) {
              printSkuStatus.textContent = 'Printing...';
            }

            try {
              const response = await fetch('/api/listing/' + encodeURIComponent(activeSku) + '/label.pdf', {
                method: 'GET',
                headers: {
                  Accept: 'application/pdf',
                },
              });

              if (!response.ok) {
                const contentType = response.headers.get('content-type') || '';
                if (contentType.includes('application/json')) {
                  const payload = await response.json().catch(() => ({}));
                  throw new Error(payload && payload.error ? payload.error : 'Unable to print SKU label.');
                }
                throw new Error('Unable to print SKU label.');
              }

              const pdfBlob = await response.blob();
              if (!pdfBlob || pdfBlob.size === 0) {
                throw new Error('Received an empty label PDF.');
              }

              console.log('[print-sku] fetched PDF bytes:', pdfBlob.size);
              const pdfUrl = URL.createObjectURL(pdfBlob);

              printPopup.location.replace(pdfUrl);

              window.setTimeout(() => {
                try {
                  printPopup.focus();
                  printPopup.print();
                } catch (printError) {
                  console.warn('[print-sku] popup print call failed:', printError);
                }
              }, 700);

              window.setTimeout(() => {
                URL.revokeObjectURL(pdfUrl);
              }, 120000);

              if (printSkuStatus) {
                printSkuStatus.textContent = 'Label PDF opened. If print dialog does not appear, press Cmd+P in the new tab.';
              }
            } catch (error) {
              try {
                printPopup.close();
              } catch (closeError) {
                // noop
              }
              if (printSkuStatus) {
                printSkuStatus.textContent = error && error.message ? error.message : 'Unable to print SKU label.';
              }
            } finally {
              if (printSkuButton) {
                printSkuButton.disabled = !activeSku;
              }
            }
          };

          const getCurrentSku = () => {
            const directSku = typeof activeSku === 'string' ? activeSku.trim() : '';
            if (directSku) {
              return directSku;
            }

            const detailText = detailSku && typeof detailSku.textContent === 'string'
              ? detailSku.textContent.trim()
              : '';

            if (!detailText || detailText === '-' || detailText === '—') {
              return '';
            }

            return detailText;
          };

          const removeActiveRowFromGrid = () => {
            if (!activeRow || !activeRow.parentNode) {
              return;
            }

            const index = rows.indexOf(activeRow);
            if (index >= 0) {
              rows.splice(index, 1);
            }

            activeRow.parentNode.removeChild(activeRow);
            activeRow = null;
          };

          const finalizeItem = async () => {
            const skuToFinalize = getCurrentSku();
            if (!skuToFinalize) {
              if (printSkuStatus) {
                printSkuStatus.textContent = 'No SKU found for this listing.';
              }
              return;
            }

            if (printSkuButton) {
              printSkuButton.disabled = true;
            }
            if (finalizeItemButton) {
              finalizeItemButton.disabled = true;
            }
            if (deleteListingButton) {
              deleteListingButton.disabled = true;
            }
            if (printSkuStatus) {
              printSkuStatus.textContent = 'Finalizing item...';
            }

            try {
              const response = await fetch('/api/listing/' + encodeURIComponent(skuToFinalize) + '/finalize', {
                method: 'POST',
                headers: {
                  Accept: 'application/json',
                },
              });

              const payload = await response.json().catch(() => ({}));
              if (!response.ok || !payload || payload.ok !== true) {
                throw new Error(payload && payload.error ? payload.error : 'Unable to finalize item.');
              }

              removeActiveRowFromGrid();

              if (printSkuStatus) {
                printSkuStatus.textContent = 'Item finalized.';
              }
              activeSku = '';
              applyFilter();
              window.setTimeout(() => {
                closeModal();
              }, 550);
            } catch (error) {
              if (printSkuStatus) {
                printSkuStatus.textContent = error && error.message ? error.message : 'Unable to finalize item.';
              }
            } finally {
              if (printSkuButton) {
                printSkuButton.disabled = !activeSku;
              }
              if (finalizeItemButton) {
                finalizeItemButton.disabled = !activeSku;
              }
              if (deleteListingButton) {
                deleteListingButton.disabled = !activeSku;
              }
            }
          };

          const deleteListing = async () => {
            const skuToDelete = getCurrentSku();
            if (!skuToDelete) {
              if (printSkuStatus) {
                printSkuStatus.textContent = 'No SKU found for this listing.';
              }
              return;
            }

            const confirmed = window.confirm('Are you sure you want to delete this listing? This will remove the listing, associated listing images, and bucket files.');
            if (!confirmed) {
              return;
            }

            if (printSkuButton) {
              printSkuButton.disabled = true;
            }
            if (finalizeItemButton) {
              finalizeItemButton.disabled = true;
            }
            if (deleteListingButton) {
              deleteListingButton.disabled = true;
            }
            if (printSkuStatus) {
              printSkuStatus.textContent = 'Deleting listing...';
            }

            try {
              const response = await fetch('/api/listing/' + encodeURIComponent(skuToDelete), {
                method: 'DELETE',
                headers: {
                  Accept: 'application/json',
                },
              });

              const payload = await response.json().catch(() => ({}));
              if (!response.ok || !payload || payload.ok !== true) {
                throw new Error(payload && payload.error ? payload.error : 'Unable to delete listing.');
              }

              removeActiveRowFromGrid();

              if (printSkuStatus) {
                printSkuStatus.textContent = 'Listing deleted.';
              }
              const deletedSku = skuToDelete;
              activeSku = '';
              applyFilter();
              window.setTimeout(() => {
                closeModal();
              }, 550);
              console.log('[delete-listing] deleted sku:', deletedSku);
            } catch (error) {
              if (printSkuStatus) {
                printSkuStatus.textContent = error && error.message ? error.message : 'Unable to delete listing.';
              }
            } finally {
              if (printSkuButton) {
                printSkuButton.disabled = !activeSku;
              }
              if (finalizeItemButton) {
                finalizeItemButton.disabled = !activeSku;
              }
              if (deleteListingButton) {
                deleteListingButton.disabled = !activeSku;
              }
            }
          };

          const loadDetails = async (sku) => {
            if (!sku) {
              return;
            }

            openModal();
            setLoadingState(sku);

            try {
              const response = await fetch('/api/listing/' + encodeURIComponent(sku) + '/details', {
                method: 'GET',
                headers: { Accept: 'application/json' },
              });
              const payload = await response.json().catch(() => ({}));

              if (!response.ok || !payload || payload.ok !== true) {
                throw new Error(payload && payload.error ? payload.error : 'Unable to load listing details.');
              }

              fillDetails(payload);
            } catch (error) {
              setErrorState(error && error.message ? error.message : 'Unable to load details.');
            }
          };

          const applyFilter = () => {
            if (!grid) {
              return;
            }

            syncEmptyState();
            if (isGridLoading || !rows.length) {
              return;
            }

            const query = searchInput.value.trim().toLowerCase();
            let visibleCount = 0;

            rows.forEach((row) => {
              const sku = (row.getAttribute('data-sku') || '').toLowerCase();
              const visible = query === '' || sku.includes(query);
              row.hidden = !visible;
              if (visible) {
                visibleCount += 1;
              }
            });

            if (emptyRow) {
              emptyRow.hidden = visibleCount > 0;
            }
          };

          const fetchListings = async () => {
            if (!grid) {
              return;
            }

            try {
              const response = await fetch('/api/dashboard-listings?state=' + encodeURIComponent(stateFilter), {
                method: 'GET',
                headers: {
                  Accept: 'application/json',
                },
              });

              const payload = await response.json().catch(() => ({}));
              if (!response.ok || !payload || payload.ok !== true) {
                throw new Error(payload && payload.error ? payload.error : 'Unable to load listings.');
              }

              if (loadErrorBanner) {
                loadErrorBanner.hidden = true;
                loadErrorBanner.textContent = '';
              }

              renderListings(Array.isArray(payload.listings) ? payload.listings : []);
            } catch (error) {
              setLoadError(error && error.message ? error.message : 'Unable to load listings.');
            }
          };

          if (form) {
            form.addEventListener('submit', (event) => {
              event.preventDefault();
            });
          }

          searchInput.addEventListener('input', applyFilter);

          if (scanSkuButton) {
            scanSkuButton.addEventListener('click', () => {
              void openScanner();
            });
          }

          if (scannerCloseButton) {
            scannerCloseButton.addEventListener('click', () => {
              stopScanner();
            });
          }

          if (grid) {
            grid.addEventListener('click', (event) => {
              const row = event.target.closest('.listing-card[data-sku]');
              if (!row || !grid.contains(row)) {
                return;
              }

              const sku = row.getAttribute('data-sku') || '';
              if (!sku) {
                return;
              }

              activeRow = row;
              void loadDetails(sku);
            });

            grid.addEventListener('keydown', (event) => {
              const row = event.target.closest('.listing-card[data-sku]');
              if (!row || !grid.contains(row)) {
                return;
              }

              if (event.key === 'Enter' || event.key === ' ') {
                event.preventDefault();
                const sku = row.getAttribute('data-sku') || '';
                if (!sku) {
                  return;
                }

                activeRow = row;
                void loadDetails(sku);
              }
            });
          }

          if (imagePrev) {
            imagePrev.addEventListener('click', () => {
              if (!activeImages.length) {
                return;
              }
              activeImageIndex = (activeImageIndex - 1 + activeImages.length) % activeImages.length;
              updateImage();
            });
          }

          if (imageNext) {
            imageNext.addEventListener('click', () => {
              if (!activeImages.length) {
                return;
              }
              activeImageIndex = (activeImageIndex + 1) % activeImages.length;
              updateImage();
            });
          }

          if (closeModalButton) {
            closeModalButton.addEventListener('click', closeModal);
          }

          if (modalBackdrop) {
            modalBackdrop.addEventListener('click', closeModal);
          }

          if (printSkuButton) {
            printSkuButton.addEventListener('click', printSkuLabel);
          }

          if (finalizeItemButton) {
            finalizeItemButton.addEventListener('click', finalizeItem);
          }

          if (deleteListingButton) {
            deleteListingButton.addEventListener('click', deleteListing);
          }

          window.addEventListener('keydown', (event) => {
            if (event.key === 'Escape' && modal && !modal.hidden) {
              closeModal();
              return;
            }

            if (event.key === 'Escape' && scannerPanel && !scannerPanel.hidden) {
              stopScanner();
            }
          });

          syncEmptyState();
          void fetchListings();
        })();
      </script>
    </div>
  </body>
</html>
