<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#322B3B" />
    <title>Nine Lives Vintage | Login</title>
    <link rel="icon" type="image/png" href="/res/app_icon.png" />
    <link rel="apple-touch-icon" href="/res/app_icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="stylesheet" href="/css/auth.css" />
  </head>
  <body>
    <main class="auth-page">
      <section class="auth-card login-card" aria-label="Login">
        <div class="auth-banner">
          <img src="/res/brand-banner.png" alt="" class="auth-banner-image" />

          <form method="post" action="/login" class="auth-form auth-banner-form">
            <label for="password" class="visually-hidden">Passcode</label>
            <input
              id="password"
              name="password"
              type="password"
              autocomplete="current-password"
              required
              placeholder="Enter your passcode"
            />

            <button type="submit">Unlock</button>
          </form>
        </div>

        <% if (error) { %>
          <div class="alert" role="alert"><%= error %></div>
        <% } %>

      </section>
    </main>
  </body>
</html>
