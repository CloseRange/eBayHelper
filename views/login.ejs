<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Nine Lives Vintage | Login</title>
    <link rel="stylesheet" href="/css/auth.css" />
  </head>
  <body>
    <main class="auth-page">
      <section class="auth-card" aria-labelledby="login-heading">
        <div class="brand-lockup">
          <img src="/res/logo-brand.png" alt="Nine Lives Vintage logo" class="brand-logo-mark" />
          <p class="brand-wordmark">Nine Lives Vintage</p>
        </div>
        <h1 id="login-heading">Welcome back</h1>
        <p class="subtitle">Enter your passcode to unlock the admin dashboard.</p>

        <% if (error) { %>
          <div class="alert" role="alert"><%= error %></div>
        <% } %>

        <form method="post" action="/login" class="auth-form">
          <label for="password">Passcode</label>
          <input
            id="password"
            name="password"
            type="password"
            autocomplete="current-password"
            required
            placeholder="Enter your passcode"
          />

          <button type="submit">Unlock</button>
        </form>
      </section>
    </main>
  </body>
</html>
