<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Nine Lives Vintage | eBay</title>
    <link rel="stylesheet" href="/css/listings.css" />
  </head>
  <body class="has-mobile-nav ebay-page">
    <div class="page-shell narrow-shell">
      <header class="ebay-page-header" aria-label="eBay connection header">
        <div class="ebay-header-lockup">
          <img src="/res/ebay-icon.svg" alt="eBay" class="ebay-header-logo" />
          <div class="ebay-header-copy">
            <h1>eBay</h1>
            <p class="ebay-header-status <%= isEbayConnected ? 'is-connected' : 'is-disconnected' %>"><%= isEbayConnected ? 'Connected to eBay' : 'Not connected to eBay' %></p>
          </div>
        </div>
        <span class="ebay-header-pill <%= isEbayConnected ? 'is-connected' : 'is-disconnected' %>"><%= isEbayConnected ? 'Connected' : 'Disconnected' %></span>
      </header>

      <% if (statusBanner) { %>
        <div class="status-banner <%= isEbayConnected ? 'success' : 'warning' %>"><%= statusBanner %></div>
      <% } %>

      <main class="wizard-card ebay-page-card">
        <div class="section-heading">
          <p class="eyebrow muted">Account</p>
          <h2>eBay integration</h2>
          <p class="selected-category"><%= isEbayConnected ? 'Connected and ready.' : 'Not connected to eBay yet.' %></p>
        </div>

        <div class="ebay-action-row">
          <form method="post" action="/ebay/test">
            <button type="submit" class="secondary-btn ebay-test-btn">Test Connection</button>
          </form>
          <button type="button" class="secondary-btn ebay-price-check-btn" id="run-price-check-button" <%= !isEbayConnected ? 'disabled' : '' %>>Run Price Check</button>
          <form method="post" action="/ebay/sync">
            <button type="submit" class="primary-btn ebay-sync-btn">Sync Now</button>
          </form>
          <button type="button" class="secondary-btn ebay-repost-btn" id="repost-listing-button" <%= !isEbayConnected ? 'disabled' : '' %>>Repost Listing</button>
        </div>
      </main>

      <div class="modal-backdrop" id="price-check-confirm-modal" hidden>
        <div class="modal-card" role="dialog" aria-modal="true" aria-labelledby="price-check-confirm-title">
          <div class="modal-header">
            <h3 id="price-check-confirm-title">Run price check?</h3>
            <button type="button" class="modal-close" data-close-price-check-confirm aria-label="Close price check dialog">×</button>
          </div>

          <div class="modal-body">
            <p>This will evaluate all active listings and lower prices based on your current price-rate thresholds.</p>
          </div>

          <div class="modal-actions">
            <button type="button" class="secondary-btn" data-close-price-check-confirm>Cancel</button>
            <button type="button" class="primary-btn" id="confirm-price-check-button">Run Price Check</button>
          </div>
        </div>
      </div>

      <div class="modal-backdrop" id="price-check-result-modal" hidden>
        <div class="modal-card" role="dialog" aria-modal="true" aria-labelledby="price-check-result-title">
          <div class="modal-header">
            <h3 id="price-check-result-title">Price check results</h3>
            <button type="button" class="modal-close" data-close-price-check-result aria-label="Close price check results">×</button>
          </div>

          <div class="modal-body">
            <p id="price-check-result-message">Price check results will appear here.</p>
            <ul id="price-check-results-list" class="price-check-results-list" hidden></ul>
          </div>

          <div class="modal-actions">
            <button type="button" class="primary-btn" data-close-price-check-result>Okay</button>
          </div>
        </div>
      </div>

      <div class="modal-backdrop" id="repost-listing-modal" hidden>
        <div class="modal-card" role="dialog" aria-modal="true" aria-labelledby="repost-listing-title">
          <div class="modal-header">
            <h3 id="repost-listing-title">Repost listing to eBay</h3>
            <button type="button" class="modal-close" data-close-repost-modal aria-label="Close repost dialog">×</button>
          </div>

          <div class="modal-body">
            <label for="repost-listing-select" class="modal-label">Choose a listing</label>
            <select id="repost-listing-select" class="repost-listing-select">
              <option value="">Loading listings...</option>
            </select>
            <p class="modal-note" id="repost-listing-empty" hidden>No listings are available to repost.</p>
          </div>

          <div class="modal-actions">
            <button type="button" class="secondary-btn" data-close-repost-modal>Cancel</button>
            <button type="button" class="primary-btn" id="confirm-repost-button">Repost</button>
          </div>
        </div>
      </div>

      <div class="modal-backdrop" id="repost-result-modal" hidden>
        <div class="modal-card" role="dialog" aria-modal="true" aria-labelledby="repost-result-title">
          <div class="modal-header">
            <h3 id="repost-result-title">Repost result</h3>
            <button type="button" class="modal-close" data-close-result-modal aria-label="Close result dialog">×</button>
          </div>

          <div class="modal-body">
            <p id="repost-result-message">Your listing repost status will appear here.</p>
          </div>

          <div class="modal-actions">
            <button type="button" class="primary-btn" data-close-result-modal>Okay</button>
          </div>
        </div>
      </div>

      <%- include('partials/mobile-nav', { currentPath }) %>
    </div>

    <script>
      const repostButton = document.getElementById('repost-listing-button');
      const repostModal = document.getElementById('repost-listing-modal');
      const repostResultModal = document.getElementById('repost-result-modal');
      const repostSelect = document.getElementById('repost-listing-select');
      const repostEmptyMessage = document.getElementById('repost-listing-empty');
      const confirmRepostButton = document.getElementById('confirm-repost-button');
      const repostResultMessage = document.getElementById('repost-result-message');
      const runPriceCheckButton = document.getElementById('run-price-check-button');
      const priceCheckConfirmModal = document.getElementById('price-check-confirm-modal');
      const priceCheckResultModal = document.getElementById('price-check-result-modal');
      const confirmPriceCheckButton = document.getElementById('confirm-price-check-button');
      const priceCheckResultMessage = document.getElementById('price-check-result-message');
      const priceCheckResultsList = document.getElementById('price-check-results-list');

      const openModal = (modal) => {
        if (!modal) return;
        modal.hidden = false;
      };

      const closeModal = (modal) => {
        if (!modal) return;
        modal.hidden = true;
      };

      const formatPrice = (value) => {
        const numeric = Number(value);
        if (!Number.isFinite(numeric)) return '$0.00';
        return `$${numeric.toFixed(2)}`;
      };

      const populateRepostOptions = async () => {
        if (!repostSelect) return;

        try {
          const response = await fetch('/api/ebay/listings-for-repost');
          const payload = await response.json();

          if (!response.ok || !payload.ok) {
            throw new Error(payload?.error || 'Unable to load listings.');
          }

          const listings = Array.isArray(payload.listings) ? payload.listings : [];
          repostSelect.innerHTML = '';

          if (!listings.length) {
            const option = document.createElement('option');
            option.value = '';
            option.textContent = 'No listings available';
            repostSelect.appendChild(option);
            repostEmptyMessage.hidden = false;
            confirmRepostButton.disabled = true;
            return;
          }

          repostEmptyMessage.hidden = true;
          confirmRepostButton.disabled = false;

          const placeholder = document.createElement('option');
          placeholder.value = '';
          placeholder.textContent = 'Select a listing';
          repostSelect.appendChild(placeholder);

          listings.forEach((listing) => {
            const option = document.createElement('option');
            option.value = listing.sku;
            option.textContent = `${listing.title || 'Untitled listing'} (${listing.sku})`;
            repostSelect.appendChild(option);
          });
        } catch (error) {
          console.error('[repost] Failed to load listings:', error);
          repostSelect.innerHTML = '<option value="">Unable to load listings</option>';
          repostEmptyMessage.hidden = false;
          confirmRepostButton.disabled = true;
        }
      };

      repostButton?.addEventListener('click', async () => {
        if (!repostButton.disabled) {
          await populateRepostOptions();
          openModal(repostModal);
        }
      });

      runPriceCheckButton?.addEventListener('click', () => {
        if (!runPriceCheckButton.disabled) {
          openModal(priceCheckConfirmModal);
        }
      });

      document.querySelectorAll('[data-close-price-check-confirm]').forEach((element) => {
        element.addEventListener('click', () => closeModal(priceCheckConfirmModal));
      });

      document.querySelectorAll('[data-close-price-check-result]').forEach((element) => {
        element.addEventListener('click', () => closeModal(priceCheckResultModal));
      });

      confirmPriceCheckButton?.addEventListener('click', async () => {
        confirmPriceCheckButton.disabled = true;
        confirmPriceCheckButton.textContent = 'Running...';

        try {
          const response = await fetch('/api/ebay/price-check', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
          });

          const payload = await response.json();
          if (!response.ok || !payload?.ok) {
            throw new Error(payload?.error || 'Price check failed.');
          }

          const updatedCount = Number(payload.updatedCount || 0);
          const checkedCount = Number(payload.evaluatedCount || 0);
          const changes = Array.isArray(payload.changedListings) ? payload.changedListings : [];

          if (updatedCount > 0 && changes.length) {
            priceCheckResultMessage.textContent = `Price check complete. Updated ${updatedCount} listing${updatedCount === 1 ? '' : 's'} out of ${checkedCount} checked.`;
            priceCheckResultsList.innerHTML = changes
              .map((change) => {
                const sku = String(change?.sku || '').trim();
                return `<li>${sku}: ${formatPrice(change?.oldPrice)} -> ${formatPrice(change?.newPrice)}</li>`;
              })
              .join('');
            priceCheckResultsList.hidden = false;
          } else {
            priceCheckResultMessage.textContent = `Price check complete. No price changes were needed across ${checkedCount} checked listing${checkedCount === 1 ? '' : 's'}.`;
            priceCheckResultsList.hidden = true;
            priceCheckResultsList.innerHTML = '';
          }

          closeModal(priceCheckConfirmModal);
          openModal(priceCheckResultModal);
        } catch (error) {
          priceCheckResultMessage.textContent = error.message || 'Unable to run price check right now.';
          priceCheckResultsList.hidden = true;
          priceCheckResultsList.innerHTML = '';
          closeModal(priceCheckConfirmModal);
          openModal(priceCheckResultModal);
        } finally {
          confirmPriceCheckButton.disabled = false;
          confirmPriceCheckButton.textContent = 'Run Price Check';
        }
      });

      document.querySelectorAll('[data-close-repost-modal]').forEach((element) => {
        element.addEventListener('click', () => closeModal(repostModal));
      });

      document.querySelectorAll('[data-close-result-modal]').forEach((element) => {
        element.addEventListener('click', () => closeModal(repostResultModal));
      });

      confirmRepostButton?.addEventListener('click', async () => {
        const sku = repostSelect?.value;
        if (!sku) {
          repostResultMessage.textContent = 'Please select a listing to repost.';
          openModal(repostResultModal);
          return;
        }

        confirmRepostButton.disabled = true;
        confirmRepostButton.textContent = 'Reposting...';

        try {
          const response = await fetch('/api/ebay/repost', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ sku }),
          });

          const payload = await response.json();
          if (!response.ok || !payload?.ok) {
            throw new Error(payload?.error || 'Repost failed.');
          }

          closeModal(repostModal);
          repostResultMessage.textContent = payload.message || `Listing ${sku} was reposted to eBay.`;
          openModal(repostResultModal);
        } catch (error) {
          closeModal(repostModal);
          repostResultMessage.textContent = error.message || 'Unable to repost this listing to eBay.';
          openModal(repostResultModal);
        } finally {
          confirmRepostButton.disabled = false;
          confirmRepostButton.textContent = 'Repost';
        }
      });
    </script>
  </body>
</html>
